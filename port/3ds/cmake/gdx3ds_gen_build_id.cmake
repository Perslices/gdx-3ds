# port/3ds/cmake/gdx3ds_gen_build_id.cmake -- hw bug n60-3d8, item 3.
#
# Invoked by the gdx3ds_build_id_header custom target (port/3ds/CMakeLists.txt) on EVERY
# build, not only at reconfigure: `git rev-parse` used to run only inside execute_process()
# at cmake-configure time, so a rebuild without a reconfigure kept baking in whatever HEAD
# was current at the LAST configure. On n60-3d8 that stamped the binary with n60-3d7's hash
# (37dc7a52 built, 88ab0de6 reported) because the card was rebuilt from a new commit without
# anyone re-running cmake first.
#
# Rewrites GDX3DS_OUT_FILE with the CURRENT branch@hash every time this script runs, but only
# actually WRITES when the text changed -- cmake's own custom-target "always out of date"
# trick (no OUTPUT on the target, just BYPRODUCTS) is what makes this script run every build;
# the write-only-on-change guard below is what stops that from becoming a full rebuild: ninja
# / make only recompiles a TU that #includes this header when the header's mtime actually
# moves, and file(WRITE ...) only touches mtime when CMake decides the content differs from
# the request -- so leaving the content untouched when the hash hasn't moved is what keeps
# "every build re-stamps" from regressing into "every build recompiles everything".
if(NOT DEFINED GDX3DS_SRC_DIR OR NOT DEFINED GDX3DS_OUT_FILE)
    message(FATAL_ERROR "gdx3ds_gen_build_id.cmake: GDX3DS_SRC_DIR and GDX3DS_OUT_FILE are required")
endif()

execute_process(COMMAND git rev-parse --abbrev-ref HEAD
                 WORKING_DIRECTORY "${GDX3DS_SRC_DIR}"
                 OUTPUT_VARIABLE _gdx3ds_branch
                 OUTPUT_STRIP_TRAILING_WHITESPACE
                 RESULT_VARIABLE _gdx3ds_branch_rc
                 ERROR_QUIET)
execute_process(COMMAND git rev-parse --short=8 HEAD
                 WORKING_DIRECTORY "${GDX3DS_SRC_DIR}"
                 OUTPUT_VARIABLE _gdx3ds_hash
                 OUTPUT_STRIP_TRAILING_WHITESPACE
                 RESULT_VARIABLE _gdx3ds_hash_rc
                 ERROR_QUIET)

if(NOT _gdx3ds_branch_rc EQUAL 0 OR _gdx3ds_branch STREQUAL "")
    set(_gdx3ds_branch "unknown")
endif()
if(NOT _gdx3ds_hash_rc EQUAL 0 OR _gdx3ds_hash STREQUAL "")
    set(_gdx3ds_hash "nohash")
endif()

set(_gdx3ds_new_content
"/* Generated by port/3ds/cmake/gdx3ds_gen_build_id.cmake -- DO NOT EDIT.
 * Regenerated at the start of every build (see the gdx3ds_build_id_header custom target in
 * port/3ds/CMakeLists.txt), from the CURRENT HEAD, not just whatever HEAD was at the last
 * cmake configure -- see that target's own comment for the hw bug this fixes (n60-3d8 #3). */
#ifndef GDX3DS_BUILD_ID_H
#define GDX3DS_BUILD_ID_H
#define GDX3DS_BUILD_ID \"${_gdx3ds_branch}@${_gdx3ds_hash}\"
#endif /* GDX3DS_BUILD_ID_H */
")

set(_gdx3ds_old_content "")
if(EXISTS "${GDX3DS_OUT_FILE}")
    file(READ "${GDX3DS_OUT_FILE}" _gdx3ds_old_content)
endif()

if(NOT _gdx3ds_old_content STREQUAL _gdx3ds_new_content)
    file(WRITE "${GDX3DS_OUT_FILE}" "${_gdx3ds_new_content}")
    message(STATUS "gdx3ds: build id -> ${_gdx3ds_branch}@${_gdx3ds_hash}")
endif()
