diff --git a/src/overlays/ovl_i2/race.c b/src/overlays/ovl_i2/race.c
--- a/src/overlays/ovl_i2/race.c
+++ b/src/overlays/ovl_i2/race.c
@@ -139,6 +139,31 @@
 
 extern Gfx D_8076CE28[];
 extern Gfx D_8076CF10[];
+
+#ifdef PORT
+/* C5 STAGE 0 (port/3ds/gdx3ds_mainprof.h, "[c5cat]"): scene-category markers for the Old 3DS
+ * per-category CPU timers. When the port's clock is armed (`[debug] gputrace=1` or
+ * `mainprof=1`) each GDX_C5CAT writes ONE G_NOOP whose w0 carries p=0x61 and the category id;
+ * the owned walker switches its timing bucket when it reaches it. Unarmed, nothing is written
+ * and the display list is byte-identical. A G_NOOP draws nothing on either interpreter. Ids
+ * must match GDX3DS_C5CAT_* in port/3ds/gdx3ds_mainprof.h (racer.c carries the same macro). */
+extern int gdx_c5cat_armed(void);
+#define GDX_C5CAT_MISC 1
+#define GDX_C5CAT_SKY 2
+#define GDX_C5CAT_TRK 3
+#define GDX_C5CAT_DRESS 4
+#define GDX_C5CAT_HUD 9
+#define GDX_C5CAT(cat)                                                              \
+    do {                                                                            \
+        if (gdx_c5cat_armed()) {                                                    \
+            gfx->words.w0 = ((u32) G_NOOP << 24) | (0x61u << 16) | GDX_C5CAT_##cat; \
+            gfx->words.w1 = 0;                                                      \
+            gfx++;                                                                  \
+        }                                                                           \
+    } while (0)
+#else
+#define GDX_C5CAT(cat)
+#endif
 
 Gfx* Race_Draw(Gfx* gfx) {
 
@@ -192,9 +217,13 @@
     gEffectsVtxEndPtr = &gGfxPool->effectsVtxBuffer[0x7FF];
     switch (gNumPlayers) {
         case 1:
+            GDX_C5CAT(SKY);
             gfx = Background_Draw(gfx, 0, SCISSOR_BOX_FULL_SCREEN);
+            GDX_C5CAT(TRK);
             gfx = Course_Draw(gfx, 0);
+            GDX_C5CAT(DRESS);
             gfx = Course_GadgetsDraw(gfx, 0);
+            GDX_C5CAT(MISC);
             break;
         case 2:
             gfx = Background_Draw(gfx, 0, SCISSOR_BOX_TOP_HALF);
@@ -250,7 +279,9 @@
             gSPMatrix(gfx++, &D_1000000.unk_20208[0], G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_PROJECTION);
             gfx = Camera_Draw(gfx, SCISSOR_BOX_FULL_SCREEN, 0);
             gfx = Racer_Draw(gfx, 0);
+            GDX_C5CAT(HUD);
             gfx = Menus_Player1SpecialDraw(gfx, 0);
+            GDX_C5CAT(MISC);
             break;
         case 2:
             gSPPerspNormalize(gfx++, gCameras[0].perspectiveScale);
@@ -296,5 +327,12 @@
             break;
     }
 
+#ifdef PORT
+    GDX_C5CAT(HUD);
+    gfx = Menus_Draw(gfx);
+    GDX_C5CAT(MISC);
+    return gfx;
+#else
     return Menus_Draw(gfx);
+#endif
 }
