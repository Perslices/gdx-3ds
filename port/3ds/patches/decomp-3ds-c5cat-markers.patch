+++ b/src/game/racer.c
@@ -5577,6 +5577,27 @@
 extern GfxPool D_1000000;
 
 #ifdef NON_MATCHING
+#ifdef PORT
+/* C5 STAGE 0 "[c5cat]" scene-category markers -- same macro and contract as race.c (see the
+ * comment there); ids must match GDX3DS_C5CAT_* in port/3ds/gdx3ds_mainprof.h. */
+extern int gdx_c5cat_armed(void);
+#define GDX_C5CAT_MISC 1
+#define GDX_C5CAT_MACH 5
+#define GDX_C5CAT_SHD 7
+#define GDX_C5CAT_FX 8
+#define GDX_C5CAT_HUD 9
+#define GDX_C5CAT(cat)                                                              \
+    do {                                                                            \
+        if (gdx_c5cat_armed()) {                                                    \
+            gfx->words.w0 = ((u32) G_NOOP << 24) | (0x61u << 16) | GDX_C5CAT_##cat; \
+            gfx->words.w1 = 0;                                                      \
+            gfx++;                                                                  \
+        }                                                                           \
+    } while (0)
+#else
+#define GDX_C5CAT(cat)
+#endif
