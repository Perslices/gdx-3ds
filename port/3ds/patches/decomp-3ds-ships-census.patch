+/* N60SHIPS [ships]: what the visibility pass just decided, counted per call (read-only). The
+   shadow / flame / highlight tests are the draw loops' own conditions below. */
+static void Racer_GdxShipsCensus(void) {
+    u8 c[GDX3DS_SHIPS_COUNT] = { 0 };
+    Racer* racer;
+    s32 i;
 
+    for (racer = sLastRacer; racer >= gRacers; racer--) {
+        if (racer->stateFlags & RACER_STATE_ACTIVE) {
+            c[GDX3DS_SHIPS_ACT]++;
+        }
+        if (racer->machineLod != 0) {
+            c[GDX3DS_SHIPS_VIS]++;
+            if ((racer->machineLod >= 1) && (racer->machineLod <= 6)) {
+                c[GDX3DS_SHIPS_L1 + racer->machineLod - 1]++;
+            }
+            if (racer->stateFlags & RACER_STATE_CRASHED) {
+                c[GDX3DS_SHIPS_CRASH]++;
+            }
+            if ((racer->attackHighlightScale != 0) && (racer->machineLod < 6)) {
+                c[GDX3DS_SHIPS_HL]++;
+            }
+        }
+        if ((gRaceIntroTimer < 280) && (racer->unk_2B2 != 0) && (racer->shadowPos.y != -54321.0f)) {
+            c[GDX3DS_SHIPS_SHD]++;
+        }
+        if ((racer->unk_2B3 != 0) && !(racer->stateFlags & (RACER_STATE_CRASHED | RACER_STATE_SPINNING_OUT))) {
+            c[GDX3DS_SHIPS_BOOST]++;
+            if (racer->unk_2B3 == 2) {
+                c[GDX3DS_SHIPS_NEAR]++;
+            }
+        }
+    }
+    if (gGameMode == GAMEMODE_TIME_ATTACK) {
+        for (i = 0; i < 3; i++) {
+            if (gGhostRacers[i].exists && (gGhostRacers[i].racer->machineLod != 0)) {
+                c[GDX3DS_SHIPS_GHOST]++;
+            }
+        }
+    }
+    gdx3ds_ships_census_add(c, gGameMode, gNumPlayers, gTotalRacers);
+}
