+/* MAINPROF (port/3ds/gdx3ds_mainprof.h, NEXT.md A8): the per-VI frame function below IS
+ * the game thread's frame, and on the 3DS it runs inline on main inside gdx_vi_tick. These
+ * checkpoints hand the [mprof] timeline the phase boundaries so main's milliseconds can be
+ * attributed to audio / logic / DL build / asset loads / submit instead of one opaque
+ * total. Ids must match the GDX3DS_MPROF_CK_* defines in that header. Diagnostic only:
+ * gdx_mprof_ck reads a clock and nothing else, and is a no-op unless [debug] mainprof=1. */
+extern void gdx_mprof_ck(int step);
+#define GDX_MP_IDLE    0
+#define GDX_MP_AUDIO   1
