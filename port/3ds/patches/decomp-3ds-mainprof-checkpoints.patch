+#define GDX_MP_DPWAIT  5
+#define GDX_MP_SEGLOAD 6
+#define GDX_MP_FBSPIN  7
+#define GDX_MP_SETTASK 8
+#define GDX_MP(n) gdx_mprof_ck(GDX_MP_##n)
 #else
 #define GDX_CK(n)
+#define GDX_MP(n)
 #endif
 
