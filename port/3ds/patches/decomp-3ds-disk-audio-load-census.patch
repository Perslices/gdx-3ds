 s32 AudioLoad_DiskLoad(AudioDiskInfo* diskInfo) {
+#ifdef PORT
+    /* THE ASYNC DISK LOAD WAS ONLY ASYNC ON CONSOLE (docs/research/native/audioasync-progress.md).
+     *
+     * Case 0 below walks `bytesRemaining` and collapses EVERY whole LBA into ONE multi-LBA
+     * AudioLoad_ReadWriteDisk request, then returns 0 and waits for it across later ticks. On
+     * a 64DD that is correct and cheap: the drive DMAs the whole span in the background while
+     * the state machine polls. In this port `sLeoHandler` is LeoReadWrite (port/n64_leo.c),
+     * which serves the WHOLE request INLINE on the calling thread -- and the calling thread is
+     * the audio producer, inside gdx_audio_produce_one_tick, holding sAudioCtxMutex. So the
+     * "async" path blocks for the whole transfer in a single call.
+     *
+     * Measured, EK build, race-mutecity-start, [debug] audioload=1:
+     *   [audioload] TICK 872952us ... asyncp=870796us/1 diskld=870791us/1 leorw=870745us/1
+     * ONE ReadWriteDisk call, 0.87 s, on the producer thread, at the course load -- which is
+     * where audioring measured the ring going dry for 51 consecutive chunks (816 ms).
+     *
+     * The state machine already knows how to come back next tick; it simply never had to. Cap
+     * the batch, and re-enter through the decomp's own AudioLoad_DiskInit for the remainder
+     * (PORT transferState 3). The cap is a byte budget rather than an LBA count because the
+     * LBA size varies by zone (D_80771978: 0x4D08 down to 0x2530), and it applies only AFTER
+     * at least one whole LBA is in the batch -- a batch of zero LBAs would fall into case 1's
+     * tail read and transfer the wrong bytes.
+     *
+     * THE SIZING RULE: a step must cost less than the 16.5 ms of audio one producer tick
+     * produces, or the producer still loses ground; it just loses it more slowly. One LBA
+     * measured ~7 ms on the lane, so the default (16 KB = exactly one LBA per batch) leaves
+     * better than 2x headroom. `[debug] audio_disk_step_kb` = 0 restores the unchanged path
+     * byte for byte, which is the killswitch and the A/B. */
+    const s32 gdxStepBytes = gdx_audio_disk_step_bytes();
+    s32 gdxBatchBytes = 0;
+    s32 gdxCapped = 0;
+#endif
 
     switch (diskInfo->transferState) {
         case 0:
@@ -2982,12 +3135,30 @@ s32 AudioLoad_DiskLoad(AudioDiskInfo* diskInfo) {
                     diskInfo->blockSize = diskInfo->bytesRemaining;
                     break;
                 }
+#ifdef PORT
+                /* Never cap to zero LBAs: case 1 would then read a tail that is not the tail. */
+                if (gdxStepBytes > 0 && diskInfo->nLbas > 0 && gdxBatchBytes >= gdxStepBytes) {
+                    gdxCapped = 1;
+                    break;
+                }
+                gdxBatchBytes += diskInfo->blockSize;
+#endif
                 diskInfo->finalLba++;
                 diskInfo->bytesRemaining -= diskInfo->blockSize;
                 diskInfo->endRamAddr += diskInfo->blockSize;
                 diskInfo->nLbas++;
             }
 
+#ifdef PORT
+            if (gdxCapped) {
+                /* Bytes still to come after this batch. diskInfo->blockSize holds the NEXT
+                   LBA's full size here, not a tail, so state 3 must not let case 1 see it. */
+                AudioLoad_ReadWriteDisk(&diskInfo->cmdBlock, OS_READ, diskInfo->nextLba,
+                                        diskInfo->ramAddr, diskInfo->nLbas, &diskInfo->mq, false);
+                diskInfo->transferState = 3;
+                return 0;
+            }
+#endif
             if (diskInfo->nLbas != 0) {
                 AudioLoad_ReadWriteDisk(&diskInfo->cmdBlock, OS_READ, diskInfo->nextLba, diskInfo->ramAddr,
                                         diskInfo->nLbas, &diskInfo->mq, false);
@@ -3012,6 +3183,21 @@ s32 AudioLoad_DiskLoad(AudioDiskInfo* diskInfo) {
             }
             bcopy(diskInfo->lbaVaddrPair->vAddr, diskInfo->endRamAddr, diskInfo->blockSize);
             return 1;
+#ifdef PORT
+        case 3:
+            /* A CAPPED batch has landed and bytes remain. Restart the machine on the rest
+               through the decomp's own entry point rather than open-coding the advance:
+               DiskInit re-arms the single-LBA read case 0 expects, resets transferState and
+               recomputes blockSize, so the only state this arm owns is where to resume.
+               devAddr is 0 because everything from here is LBA-aligned -- the unaligned head
+               was consumed by the first case 0. */
+            if (AudioLoad_DiskCheckQueue(diskInfo) == -1) {
+                return 0;
+            }
+            AudioLoad_DiskInit(diskInfo, diskInfo->finalLba, 0, diskInfo->endRamAddr,
+                               diskInfo->bytesRemaining);
+            return 0;
+#endif
         default:
             return 0;
     }
