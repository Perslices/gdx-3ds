+#define GDX_C5SUB_SMOKE 15
+#define GDX_C5SUB_PITFF 16
+#define GDX_C5SUB_FALLX 17
+#if defined(GDX_NATIVE_FX)
+#define GDX_C5SUB_FXFLUSH()                    \
+    do {                                       \
+        if (gdxfx_active && gdxfx_pending()) { \
+            gdxfx_marker(gfx++);               \
+        }                                      \
     } while (0)
 #else
+#define GDX_C5SUB_FXFLUSH()
+#endif
+#define GDX_C5SUB(sub)                                                                \
+    do {                                                                              \
+        if (gdx_c5sub_armed()) {                                                      \
+            GDX_C5SUB_FXFLUSH();                                                      \
+            gfx->words.w0 = ((u32) G_NOOP << 24) | (0x62u << 16) | GDX_C5SUB_##sub; \
+            gfx->words.w1 = 0;                                                        \
+            gfx++;                                                                    \
+        }                                                                             \
+    } while (0)
+#else
 #define GDX_C5CAT(cat)
