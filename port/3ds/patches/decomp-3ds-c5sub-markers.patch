+/* C5 STAGE 3b "[c5sub]" sub-category markers (diagnostic, [debug] c5sub=1): p=0x62 + a sub-id at
+ * each effect class boundary, so [c5cat] fx= splits by class. Inside the fx shim bracket a
+ * pending native fx run is closed first (exactly what the next class's setup list would do), so
+ * the run's replay marker lands in the class it belongs to. Ids match GDX3DS_C5SUB_*. */
+extern int gdx_c5sub_armed(void);
+#define GDX_C5SUB_BOOST 10
+#define GDX_C5SUB_EXPL 11
+#define GDX_C5SUB_DEBRIS 12
+#define GDX_C5SUB_FSPARK 13
