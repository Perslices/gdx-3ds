+
+#ifdef PORT
+/* C5 STAGE 3b "[c5sub]" sub-category markers (diagnostic, [debug] c5sub=1 on top of the [c5cat]
+ * clock): ONE G_NOOP with p=0x62 and a sub-id at each piece boundary of the course dressing, so
+ * the walker can split [c5cat] dress= into mines / jumps / course effects by type / decorations.
+ * Unarmed nothing is written and the display list is byte-identical. Ids must match
+ * GDX3DS_C5SUB_* in port/3ds/gdx3ds_mainprof.h. */
+extern int gdx_c5sub_armed(void);
+#define GDX_C5SUB_MINE 1
+#define GDX_C5SUB_JUMP 2
+#define GDX_C5SUB_CEFF 3
+#define GDX_C5SUB_DSIGN 8
+#define GDX_C5SUB_DBLDG 9
+#define GDX_C5SUB_ID(id)                                                     \
+    do {                                                                     \
+        if (gdx_c5sub_armed()) {                                             \
+            gfx->words.w0 = ((u32) G_NOOP << 24) | (0x62u << 16) | (u32)(id); \
+            gfx->words.w1 = 0;                                               \
+            gfx++;                                                           \
+        }                                                                    \
+    } while (0)
+#define GDX_C5SUB(sub) GDX_C5SUB_ID(GDX_C5SUB_##sub)
+/* course effect of type t (COURSE_EFFECT_PIT..ICE = 1..4) -> sub-id 3 + t */
+#define GDX_C5SUB_EFFECT(t) GDX_C5SUB_ID(GDX_C5SUB_CEFF + ((t) & 0xF))
+#else
+#define GDX_C5SUB(sub)
+#define GDX_C5SUB_EFFECT(t)
+#endif
 
