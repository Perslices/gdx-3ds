             gdxRandTick = sGdxDetCount;
diff --git a/src/audio/rom/lib/thread.c b/src/audio/rom/lib/thread.c
index 86991b3..1f0fde2 100644
--- a/src/audio/rom/lib/thread.c
+++ b/src/audio/rom/lib/thread.c
@@ -136,7 +136,25 @@ AudioTask* AudioThread_CreateTask(void) {
     }
 #endif
     gCurAbiCmdBuffer = AudioSynth_Update(gCurAbiCmdBuffer, &abiCmdCount, aiBuffer, gAiBufLengths[aiBufIndex]);
+#ifdef PORT
+    /* ORACLE determinism pin (port/gdx_determinism.c): same osGetCount() entropy term as the
+       disk audio library's thread.c, same deterministic-counter substitute, off (original
+       expression byte for byte) unless [debug] det_audio pins it. */
+    {
+        extern int gdx_det_audio_pin(void);
+        u32 gdxRandTick;
+        if (gdx_det_audio_pin()) {
+            static u32 sGdxDetCount = 0;
+            sGdxDetCount += 0x9E3779B9u; /* golden-ratio step: distinct per task */
+            gdxRandTick = sGdxDetCount;
+        } else {
+            gdxRandTick = (u32) osGetCount();
+        }
+        gAudioRandom = gdxRandTick * (gAudioRandom + gTotalTaskCount);
+    }
+#else
     gAudioRandom = osGetCount() * (gAudioRandom + gTotalTaskCount);
+#endif
     gAudioRandom = gAiBuffers[aiBufIndex][gTotalTaskCount & 0xFF] + gAudioRandom;
 
     aiBufIndex = gRspTaskIndex;
