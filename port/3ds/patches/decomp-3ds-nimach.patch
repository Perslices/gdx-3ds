+/* NIMACH ([native] ni_mach bit 2, nimach-progress.md): machine settings / GP next machine -- the
+ * body pass (D_303A5F8, the lights) of every player as ONE NRR mach marker. Called after the stock
+ * outline pass (D_303A7D8: it stays the stock mesh draw -- no texture-set list of its own, it samples
+ * whatever the walk left in TMEM). Makes the stock pass's game-state write (Lights_SetSource) before
+ * the snapshot reads the lights, writes the pass's setup list and lights, then the marker; players
+ * whose (body list, settings pass) has no complete record follow as the stock commands (the marker
+ * arms the recorder); the last player's viewport / matrix last, so the reflection pass walks in the
+ * stock state (the RDP registers the bodies leave: the port, at the marker). Returns NULL when the
+ * NRR took nothing (the caller writes the stock pass; Lights_SetSource writes the same values). */
+static Gfx* MachineSettings_NimachBodies(Gfx* gfx, Object* machineObj) {
+    static GdxNrrMachMenuSnap sSnap;
+    GdxNrrMachMenuSnap* f = &sSnap;
+    Gfx* out;
+    u32 legacy = 0;
+    s32 fallback = 0;
+    s32 last = gNumPlayers - 1;
+    s32 i;
+    s32 k;
+
+    if ((gNumPlayers < 1) || (gNumPlayers > 4)) {
+        return NULL;
+    }
+    Lights_SetSource(gGfxPool->unk_21A88, 0, 0, 0, 255, 255, 255, 50, 25, 34);
+    f->n = 0;
+    f->ctx = GDX_NRR_MACH_CTX_SETTINGS;
+    for (k = 0; k < 3; k++) {
+        f->ldir[0][k] = f->ldir[1][k] = gGfxPool->unk_21A88[0].l[0].l.dir[k];
+        f->lcol[0][k] = f->lcol[1][k] = gGfxPool->unk_21A88[0].l[0].l.col[k];
+        f->amb[0][k] = f->amb[1][k] = gGfxPool->unk_21A88[0].a.l.col[k];
+    }
+    for (i = 0; i < gNumPlayers; i++) {
+        Machine* machine = &gMachines[gRacers[i].character];
+        s32 skin = gRacers[i].machineSkinIndex;
+
+        if (gdx3ds_nrr_mach_ready(gRacers[i].character * 6, GDX_NRR_MACH_MSBODY)) {
+            MachineSettings_NimachEnt(f, &gGfxPool->unk_20308[i], machineObj, i, GDX_NRR_MACH_MSBODY,
+                                      machine->red[skin], machine->green[skin], machine->blue[skin]);
+        } else {
+            legacy |= 1u << i;
+            fallback++;
         }
     }
+    f->rec = legacy != 0;
+    gSPDisplayList(gfx++, D_303A5F8);
+    gSPLight(gfx++, &D_1000000.unk_21A88[0].l[0], 1);
+    gSPLight(gfx++, &D_1000000.unk_21A88[0].a, 2);
+    out = gdx3ds_nrr_mach_menu_publish(gfx, f, fallback);
+    if (out == NULL) {
+        return NULL;
+    }
+    gfx = out;
+    for (i = 0; i < gNumPlayers; i++) {
+        if (legacy & (1u << i)) {
+            gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + i);
+            gSPMatrix(gfx++, &D_1000000.unk_20308[i], G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+            gfx = func_8009CCBC(gfx, gRacers[i].character, gRacers[i].machineSkinIndex);
+        }
+    }
+    if (!(legacy & (1u << last))) {
+        gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + last);
+        gSPMatrix(gfx++, &D_1000000.unk_20308[last], G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    }
     return gfx;
 }
