+/* NIMACH: one machine slot's stock commands (the loop body of MachineSelect_MachineDraw). */
+static Gfx* MachineSelect_NimachStock(Gfx* gfx, Object* machineObj, s32 i) {
+    s32 j = (i < sMachinesUnlocked) ? 0 : 1;
+
+    gDPPipeSync(gfx++);
+    gSPLight(gfx++, &D_1000000.unk_21A88[j].l[0], 1);
+    gSPLight(gfx++, &D_1000000.unk_21A88[j].a, 2);
+    gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + i);
+    gSPMatrix(gfx++, &D_1000000.unk_20308[MachineSelect_NimachSelected(i) ? 0 : 1],
+              G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    return func_8009CCBC(gfx, Character_GetCharacterFromSlot(i), 0);
+}
 
+/* NIMACH ([native] ni_mach bit 1, nimach-progress.md): the 30 machines of the select grid as ONE
+ * NRR mach marker. Called after the stock prologue (projection, D_303A5F8, the lights written by
+ * Lights_SetSource). Every slot whose (body list, menu pass) has a complete record goes into the
+ * snapshot -- its GfxPool matrix, its Vp, its light set and env colour (func_8009CCBC's); the rest
+ * are written as the stock commands after the marker, which the marker arms the recorder for.
+ * The RSP state the stock loop leaves (slot 29's lights, viewport, matrix) is written last; the RDP
+ * registers its draws leave (env colour, combine, ...) the port applies at the marker.
+ * Returns NULL when the NRR took nothing (the caller writes the stock loop). No game state is
+ * written here: the stock loop writes none either. */
+static Gfx* MachineSelect_NimachMachines(Gfx* gfx, Object* machineObj) {
+    static GdxNrrMachMenuSnap sSnap;
+    GdxNrrMachMenuSnap* f = &sSnap;
+    Gfx* out;
+    u32 legacy = 0;
+    s32 fallback = 0;
+    s32 i;
+    s32 j;
+    s32 k;
+
+    f->n = 0;
+    f->rec = 0;
+    f->ctx = GDX_NRR_MACH_CTX_SELECT;
+    for (j = 0; j < 2; j++) {
+        Lights1* lights = &gGfxPool->unk_21A88[j];
+        for (k = 0; k < 3; k++) {
+            f->ldir[j][k] = lights->l[0].l.dir[k];
+            f->lcol[j][k] = lights->l[0].l.col[k];
+            f->amb[j][k] = lights->a.l.col[k];
+        }
+    }
+    for (i = 0; i < 30; i++) {
+        s32 character = Character_GetCharacterFromSlot(i);
+        Machine* machine = &gMachines[character];
+        GdxNrrMachMenuEnt* e;
+        const s32* words;
+        const Vp* vp = MACHINE_VIEWPORT(machineObj) + i;
+
+        if (!gdx3ds_nrr_mach_ready(character * 6, GDX_NRR_MACH_MBODY)) {
+            legacy |= 1u << i;
+            fallback++;
+            continue;
+        }
+        e = &f->e[f->n++];
+        words = (const s32*) &gGfxPool->unk_20308[MachineSelect_NimachSelected(i) ? 0 : 1];
+        for (k = 0; k < 16; k++) {
+            e->mtx[k] = words[k];
+        }
+        for (k = 0; k < 4; k++) {
+            e->vp[k] = vp->vp.vscale[k];
+            e->vp[4 + k] = vp->vp.vtrans[k];
+        }
+        e->idx = character * 6;
+        e->kind = GDX_NRR_MACH_MBODY;
+        e->rgb[0] = machine->red[0];
+        e->rgb[1] = machine->green[0];
+        e->rgb[2] = machine->blue[0];
+        e->light = (i < sMachinesUnlocked) ? 0 : 1;
+    }
+    f->rec = legacy != 0;
+    out = gdx3ds_nrr_mach_menu_publish(gfx, f, fallback);
+    if (out == NULL) {
+        return NULL;
+    }
+    gfx = out;
+    for (i = 0; i < 30; i++) {
+        if (legacy & (1u << i)) {
+            gfx = MachineSelect_NimachStock(gfx, machineObj, i);
+        }
+    }
+    if (!(legacy & (1u << 29))) {
+        j = (29 < sMachinesUnlocked) ? 0 : 1;
+        gDPPipeSync(gfx++);
+        gSPLight(gfx++, &D_1000000.unk_21A88[j].l[0], 1);
+        gSPLight(gfx++, &D_1000000.unk_21A88[j].a, 2);
+        gSPViewport(gfx++, MACHINE_VIEWPORT(machineObj) + 29);
+        gSPMatrix(gfx++, &D_1000000.unk_20308[MachineSelect_NimachSelected(29) ? 0 : 1],
+                  G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    }
+    return gfx;
+}
