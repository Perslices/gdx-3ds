; port/3ds/probes/drawprobe/drawprobe.v.pica -- PROBE, NOT PART OF THE GAME BUILD.
; A machine-like vertex shader for the o3ds60 cost probe: position/normal/uv in, modelview
; and projection multiply, normalized view-space normal, one directional light (dp3) plus
; ambient, three livery colours, clamped colour + texcoord out.
; `scales` = (position scale, normal scale, uv scale, unused) so one program serves both
; the float vertex format (scales 1) and the short/byte one (fixed-point scales).

; Uniforms
.fvec projection[4], modelView[4]
.fvec lightDir, lightAmb, scales
.fvec livery[3]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy
.alias  half  myconst.wwww

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs
.alias inpos v0
.alias innrm v1
.alias intex v2

.proc main
	; r0 = (inpos.xyz * posScale, 1)
	mul r0.xyz, scales.xxxx, inpos
	mov r0.w,   ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; outtc0 = intex * uvScale
	mul outtc0, scales.zzzz, intex

	; r1 = normalize(mat3(modelView) * (innrm * nrmScale))
	mul r0.xyz, scales.yyyy, innrm
	mov r0.w,   zeros
	dp4 r1.x,   modelView[0], r0
	dp4 r1.y,   modelView[1], r0
	dp4 r1.z,   modelView[2], r0
	mov r1.w,   zeros
	dp3 r2,     r1, r1
	rsq r2,     r2
	mul r1,     r2, r1

	; r0.x = max(0, lightDir . n)
	dp3 r0.x, lightDir, r1
	max r0,   zeros, r0

	; r3 = livery0 * (ambient + diffuse)
	add r2, lightAmb, r0.xxxx
	mul r3, livery[0], r2

	; r3 += livery1 * diffuse * 0.5   (an accent colour)
	mul r2, livery[1], r0.xxxx
	mul r2, half, r2
	add r3, r2, r3

	; r3 += livery2 * ambient          (a trim colour)
	mov r4, lightAmb
	mul r2, livery[2], r4
	add r3, r2, r3

	; outclr = clamp(r3, 0, 1)
	min outclr, ones, r3

	end
.end
