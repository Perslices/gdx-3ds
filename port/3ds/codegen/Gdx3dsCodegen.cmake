# port/3ds/codegen/Gdx3dsCodegen.cmake -- C4o: Old 3DS code generation profile.
#
# WHY. The Old 3DS is a 268 MHz ARM11 MPCore with 16 KiB L1 I/D caches per core and NO L2
# (the New 3DS has 2 MiB of L2). Every I-cache miss is a trip to FCRAM, so on this console
# code SIZE and code LOCALITY are performance, not just footprint. The stock devkitARM
# Release flags (-O2, ARM mode, -ffunction-sections + --gc-sections, no LTO) lay the 2.5 MB
# .text out in link order, so the few hundred KB that actually run every frame are spread
# across the whole image between menus, resource loaders and libstdc++ locale code.
#
# WHAT. With the profile resolved to `o3ds`:
#   1. COLD code is compiled -Os (GDX_3DS_CODEGEN_COLD_OPT). Everything not on the list
#      below: menus, boot, resource/archive loading, the LUS carve outside the hot path,
#      net, assets, the decomp outside the per-frame race/audio code.
#   2. HOT code keeps -O2 (GDX_3DS_CODEGEN_HOT_OPT): the owned interpreter + citro3d
#      backend (whole targets) and the TUs a PC-sampled race profile put on the hot path
#      (GDX3DS_CODEGEN_HOT_SOURCES below; docs/research/native/o3dsflags-progress.md).
#   3. HOT-FIRST FUNCTION ORDER (GDX_3DS_CODEGEN_HOTORDER): ld's --section-ordering-file
#      places the profiled hot functions contiguously at the start of .text, in profile
#      order, so the per-frame working set shares pages/TLB entries and stops competing
#      with cold neighbours for I-cache sets. The file is o3ds-hot.ld next to this one,
#      generated by tools/native/o3ds_hotorder.py from a sample file; a name that no
#      longer exists simply matches nothing (the order degrades, the build does not).
#
# `stock` changes NOTHING: no option, no link flag, no definition reaches any target, so the
# New 3DS build (profile auto -> stock) is the same translation as before this file existed.
#
# Receipts: the configure line below; `arm-none-eabi-nm G-Diffuser-3DS.elf | grep
# gdx3ds_codegen_` (a --defsym per active piece, absolute symbols, no bytes in the image);
# and every CU's DW_AT_producer (readelf --debug-dump=info) names its -O level.
#
# A/B: -DGDX_3DS_CODEGEN=stock on an O3DS build is the baseline-flags build, identical in
# every other respect.

# REL1CRASH (2026-09-29): `auto` resolves to STOCK on every build until the o3ds profile has
# booted on real hardware. Release preview 1 (native/main@3355c37, auto -> o3ds) died at boot on
# the Old 3DS, deterministically, in a window the stock-codegen wave3 build (4bbc957) passes;
# the o3ds profile had never run on hardware (o3dsflags' A/B card was staged, never run), and
# the emulator cannot see the hardware-only failure modes (alignment faults, core timing). The
# profile is unchanged and one flag away: -DGDX_3DS_CODEGEN=o3ds. Flip `auto` back once a
# hardware card clears it (docs/research/native/rel1crash-progress.md).
set(GDX_3DS_CODEGEN "auto" CACHE STRING
    "C4o code generation profile: auto (stock until o3ds is hardware-cleared) | stock | o3ds")
set_property(CACHE GDX_3DS_CODEGEN PROPERTY STRINGS auto stock o3ds)
set(GDX_3DS_CODEGEN_COLD_OPT "-Os" CACHE STRING
    "C4o: optimisation flag for cold code under the o3ds profile (empty = leave -O2)")
set(GDX_3DS_CODEGEN_HOT_OPT "-O2" CACHE STRING
    "C4o: optimisation flag for the hot sources/targets under the o3ds profile")
option(GDX_3DS_CODEGEN_HOTORDER
       "C4o: place profiled hot functions first in .text (o3ds profile only)" ON)

set(GDX3DS_CODEGEN "${GDX_3DS_CODEGEN}")
if(GDX3DS_CODEGEN STREQUAL "auto")
    set(GDX3DS_CODEGEN "stock")
    if(GDX_3DS_O3DS)
        message(STATUS "G-Diffuser-3DS: codegen auto -> stock on an O3DS build (REL1CRASH: the o3ds "
                       "profile is not hardware-cleared; -DGDX_3DS_CODEGEN=o3ds opts in).")
    endif()
endif()
if(NOT GDX3DS_CODEGEN MATCHES "^(stock|o3ds)$")
    message(FATAL_ERROR "GDX_3DS_CODEGEN=${GDX_3DS_CODEGEN}: expected auto, stock or o3ds.")
endif()

# Targets whose every TU is on the per-frame path: the owned interpreter and the citro3d
# backend + retained-mesh draw.
set(GDX3DS_CODEGEN_HOT_TARGETS gdx3ds_n64 gdx3ds_gfx)

# Targets the profile touches at all. Anything else linked into the game (gdx3ds_net, the
# harness) is left alone except the cold flag.
set(GDX3DS_CODEGEN_TARGETS
    gdx3ds_game gdx3ds_glue gdx3ds_n64 gdx3ds_gfx gdx3ds_lus_carve gdx3ds_lus_glue
    gdx3ds_cxd4_rsp gdx3ds_os gdx3ds_audio gdx3ds_assets gdx3ds_zipshim gdx3ds_miniz
    gdx3ds_net G-Diffuser-3DS)

# Hot TUs inside otherwise-cold targets, repo-relative. Chosen from the PC-sampled race
# window of race-mutecity-start (all=1 interp=1, audio_ctx_narrow=1): every TU with >= 0.2%
# of the non-idle samples on the render, game-fiber or audio threads, plus the audio HLE /
# synthesis chain that runs on core 1. See o3dsflags-progress.md §2 for the table.
set(GDX3DS_CODEGEN_HOT_SOURCES
    # core 1: the audio producer (HLE synthesis + the decomp sequencer it drives)
    port/n64_audio_hle.c
    port/gdx_audio_lle.c
    port/gdx_audio_thread.cpp
    port/n64_sched.c
    decomp/src/audio/rom/lib/seqplayer.c
    decomp/src/audio/rom/lib/synthesis.c
    decomp/src/audio/rom/lib/effects.c
    decomp/src/audio/rom/lib/load.c
    decomp/src/audio/rom/lib/playback.c
    decomp/src/audio/rom/lib/thread.c
    decomp/src/audio/rom/external.c
    port/3ds/audio/gdx3ds_audio_ndsp.c
    # core 0: bridge pre-pass, config lookups on the draw path, asset binding lookups
    port/n64_gfx_bridge.cpp
    port/3ds/os/gdx3ds_config.c
    port/gen/AssetBindings.c
    port/gdx_segment_source.c
    port/input_bridge.c
    port/gdx_hud_placement.c  # nihudtop Phase 3: split out of input_bridge.c, same hot-path call
                               # site (menus.c, every frame); keep it on the same -O2 list.
    port/3ds/lus_glue/gdx3ds_cvar_stub.cpp
    port/3ds/lus_glue/gdx3ds_context_stub.cpp
    # core 0: the game fiber's per-frame race code
    decomp/src/game/racer.c
    decomp/src/game/course.c
    decomp/src/game/course_gadgets.c
    decomp/src/game/camera.c
    decomp/src/sys/math.c
    decomp/src/sys/sys_gfx.c
    decomp/src/overlays/ovl_i3/cpu.c
    decomp/src/overlays/ovl_i3/hud.c
    # the legacy Fast3D interpreter: cold under [native] interp=1, THE hot path under
    # interp=0, which stays a supported A/B lever -- keep it at the hot level
    port/3ds/vendor/lus/src/fast/interpreter.cpp
)

function(gdx3ds_codegen_apply)
    if(NOT GDX3DS_CODEGEN STREQUAL "o3ds")
        message(STATUS "G-Diffuser-3DS: codegen profile stock (C4o) -- toolchain Release flags.")
        return()
    endif()

    set(_n_hot 0)
    foreach(_t IN LISTS GDX3DS_CODEGEN_TARGETS)
        if(NOT TARGET ${_t})
            continue()
        endif()
        list(FIND GDX3DS_CODEGEN_HOT_TARGETS ${_t} _is_hot_target)
        if(_is_hot_target GREATER -1)
            if(GDX_3DS_CODEGEN_HOT_OPT)
                target_compile_options(${_t} PRIVATE ${GDX_3DS_CODEGEN_HOT_OPT})
            endif()
            continue()
        endif()
        if(GDX_3DS_CODEGEN_COLD_OPT)
            target_compile_options(${_t} PRIVATE ${GDX_3DS_CODEGEN_COLD_OPT})
        endif()
        # Per-source hot override: a source property comes after the target options on
        # the command line, so the last -O wins.
        get_target_property(_srcs ${_t} SOURCES)
        get_target_property(_sdir ${_t} SOURCE_DIR)
        foreach(_s IN LISTS _srcs)
            if(_s MATCHES "^\\$<")
                continue()
            endif()
            get_filename_component(_abs "${_s}" ABSOLUTE BASE_DIR "${_sdir}")
            file(RELATIVE_PATH _rel "${CMAKE_SOURCE_DIR}" "${_abs}")
            list(FIND GDX3DS_CODEGEN_HOT_SOURCES "${_rel}" _hit)
            if(_hit GREATER -1 AND GDX_3DS_CODEGEN_HOT_OPT)
                set_property(SOURCE "${_abs}" TARGET_DIRECTORY ${_t}
                             APPEND PROPERTY COMPILE_OPTIONS ${GDX_3DS_CODEGEN_HOT_OPT})
                math(EXPR _n_hot "${_n_hot} + 1")
            endif()
        endforeach()
    endforeach()

    target_link_options(G-Diffuser-3DS PRIVATE "LINKER:--defsym=gdx3ds_codegen_o3ds=1")
    set(_order "off")
    if(GDX_3DS_CODEGEN_HOTORDER)
        set(_ld "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/o3ds-hot.ld")
        target_link_options(G-Diffuser-3DS PRIVATE
            "LINKER:--section-ordering-file=${_ld}"
            "LINKER:--defsym=gdx3ds_codegen_hotorder=1")
        set_property(TARGET G-Diffuser-3DS APPEND PROPERTY LINK_DEPENDS "${_ld}")
        set(_order "${_ld}")
    endif()
    list(LENGTH GDX3DS_CODEGEN_HOT_SOURCES _n_list)
    message(STATUS "G-Diffuser-3DS: CODEGEN PROFILE o3ds (C4o) -- cold ${GDX_3DS_CODEGEN_COLD_OPT}, "
                   "hot ${GDX_3DS_CODEGEN_HOT_OPT} on [${GDX3DS_CODEGEN_HOT_TARGETS}] + "
                   "${_n_hot}/${_n_list} listed TUs, hot-first order: ${_order}. "
                   "-DGDX_3DS_CODEGEN=stock is the A/B baseline.")
    if(NOT _n_hot EQUAL _n_list)
        message(WARNING "C4o: ${_n_list} hot TUs listed, ${_n_hot} matched a target source -- "
                        "a listed path was renamed or removed; refresh the list.")
    endif()
endfunction()
