# menus-longtail: every front-end screen the race replays never draw.
# SELECT MODE grid cursor -> OPTIONS (rows, value change, erase-data box, EXIT)
# -> TIME ATTACK sub-popup -> RECORDS cup select -> records course list -> RECORDS screen.
# Modes visited: 0 TITLE, 7 MAIN_MENU, 20 OPTIONS_MENU, 19 RECORDS_COURSE_SELECT, 6 RECORDS.
# SHOT PLACEMENT IS NOT AUTHORED HERE ANY MORE (NEXT.md B15/B43, coverage2-progress.md).
# This file is the INPUT script: ticks, buttons, sticks. The schedule that decides which frames
# the parity gate hashes is DERIVED from a `[debug] cov=1` coverage census of the replay and
# written into the .gdxrec by tools/dev/covsched.py. Regenerating a .gdxrec from this file
# therefore produces a recording with NO SHOTs; re-apply the schedule with
#   tools/dev/covsched.py derive <cov-run>/log-*.txt --rewrite in.gdxrec out.gdxrec
# The hand-placed schedules this file used to carry covered 49-80% of what their replay draws.
build native/replays@d45fe63
seed1 0x1234abcd
seed2 0x0fedcba9
pins renderthread=0 rival_detail_auto=0 stereo=1 fh_every=0
note SELECT MODE grid is 4x2; non-EK redirects idx3->2, idx4->5, idx7->6.
at 350
wait 1
at 400
press START 15 0
